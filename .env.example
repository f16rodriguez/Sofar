# Copy to .env.local for `next dev`, or export in the shell for scripts.
# Never commit real values.

# --- M0: Supabase -----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server functions only — never exposed to the browser (SPEC §7)
SUPABASE_SERVICE_ROLE_KEY=

# --- M0: LLM (Anthropic) ----------------------------------------------------
# No data retention beyond request; no-training policy stated on privacy page.
ANTHROPIC_API_KEY=

# --- M0: Speech-to-text (Deepgram Nova batch, behind lib/stt.ts) ------------
DEEPGRAM_API_KEY=

# --- Site ---------------------------------------------------------------
# The address people use. Redirects and the magic-link return address are
# built from this, never from the request (see lib/site.ts). Netlify's own
# URL variable is the fallback.
SITE_URL=

# --- Access: invite-only until billing exists ---------------------------
# Comma-separated. Unset means nobody can sign in (fails closed, by design).
SOFAR_ALLOWED_EMAILS=

# --- M5: Billing ------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FULL_MONTHLY=
STRIPE_PRICE_FULL_ANNUAL=

# --- M5: Web push (VAPID) ---------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- M3+: Email (Resend) ----------------------------------------------------
RESEND_API_KEY=
